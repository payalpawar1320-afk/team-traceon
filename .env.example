# EvidenceGuard AI Configuration Example
# Copy this file to .env and configure for local development
# NEVER commit .env to version control

# Server Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Security & CORS
# In production, set to exact frontend origins only
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Database
DATABASE_URL=sqlite:///./evidenceguard.db

# Storage Paths (Local Prototype - outside public frontend directory)
STORAGE_BASE_DIR=./storage
EVIDENCE_UPLOAD_DIR=./storage/evidence
DERIVED_OUTPUT_DIR=./storage/derived
REPORTS_DIR=./storage/reports

# File Upload Limits (Bytes)
# Default: 100MB per file
MAX_UPLOAD_SIZE_BYTES=104857600
